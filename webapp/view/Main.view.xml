<mvc:View controllerName="ui5project1.controller.Main"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form">

    <App id="app2">
        <Page id="page2" title="Main View Model">
            <form:SimpleForm id="_IDGenSimpleForm1"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanL="3" labelSpanM="3"
                emptySpanL="4" emptySpanM="4"
                columnsL="1" columnsM="1"
                class="sapUiSmallMargin">

                <Label id="_IDGenLabel5" text="Employee No"/>
                <Input value="{/empStr/empNo}" id="empNo2"/>

                <Label id="_IDGenLabel6" text="Employee Name"/>
                <Input value="{/empStr/empName}" id="empName2"/>

                <Label id="_IDGenLabel7" text="Employee Dept"/>
                <Input id="empDept2"/>

                <Label id="_IDGenLabel8" text="Salary"/>
                <Input value="{/empStr/salary}" type="Number" id="empSalary2"/>

                <Button id="_IDGenButton1" text="Display" icon="sap-icon://search" press="onDisplayPress"/>
            </form:SimpleForm>
        </Page>
    </App>
</mvc:View>
